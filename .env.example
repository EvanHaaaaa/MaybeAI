# LLM Provider Override (opsional: gemini | openai | ollama | mock)
# Jika diset, menimpa nilai llm.provider di config/settings.json
MAYBEAI_LLM_PROVIDER=

# API Keys (Pilih salah satu atau gunakan mode mock otomatis jika kosong)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Local Ollama / vLLM Endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Security & Creator Access
# Token rahasia untuk otentikasi Creator pada WebSocket /ws (?token=...)
# Jika kosong, klien loopback (127.0.0.1 / ::1) tetap mendapat status Creator secara default
MAYBEAI_CREATOR_TOKEN=

# Twitch Chat Integration
TWITCH_CHANNEL=
TWITCH_BOT_NICK=
TWITCH_OAUTH_TOKEN=

# YouTube Live Chat Integration (YouTube Data API v3)
YOUTUBE_API_KEY=

# Discord Chat Integration (Discord Bot Token)
DISCORD_BOT_TOKEN=

# Semantic Memory Embedding Provider Override (opsional: auto | local | gemini | openai | hash)
MAYBEAI_EMBEDDING_PROVIDER=

# VTube Studio API
VTS_API_HOST=localhost
VTS_API_PORT=8001
VTS_AUTH_TOKEN=
